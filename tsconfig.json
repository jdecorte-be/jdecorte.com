{
  "compilerOptions": {
    "target": "ES6",
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": false,
    "forceConsistentCasingInFileNames": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "baseUrl": ".",
    "paths": {
      "@/*": [
        "./*"
      ],
      "@/components/*": [
        "components/*"
      ],
      "@/data/*": [
        "data/*"
      ],
      "@/layouts/*": [
        "layouts/*"
      ],
      "@/css/*": [
        "css/*"
      ],
      "contentlayer/generated": [
        "./.contentlayer/generated"
      ],
      "pliny/analytics": [
        "./node_modules/pliny/analytics/index.d.ts"
      ],
      "pliny/utils/formatDate": [
        "./node_modules/pliny/utils/formatDate.d.ts"
      ],
      "pliny/utils/contentlayer": [
        "./node_modules/pliny/utils/contentlayer.d.ts"
      ],
      "pliny/mdx-components": [
        "./node_modules/pliny/mdx-components.d.ts"
      ],
      "pliny/ui/TOCInline": [
        "./node_modules/pliny/ui/TOCInline.d.ts"
      ],
      "pliny/ui/Bleed": [
        "./node_modules/pliny/ui/Bleed.d.ts"
      ]
    },
    "plugins": [
      {
        "name": "next"
      }
    ],
    "strictNullChecks": true,
    "incremental": true
  },
  "include": [
    "next-env.d.ts",
    "**/*.js",
    "**/*.mjs",
    "**/*.ts",
    "**/*.tsx",
    "**/*.json",
    ".contentlayer/generated",
    ".contentlayer/generated/**/*.json",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts",
    ".next-audit/types/**/*.ts",
    ".next-audit/dev/types/**/*.ts"
  ],
  "exclude": [
    "node_modules"
  ]
}
