# MongoDB connection string for the self-hosted comment system
MONGODB_URI=


MAILCHIMP_API_KEY=
MAILCHIMP_API_SERVER=
MAILCHIMP_AUDIENCE_ID=

BUTTONDOWN_API_KEY=

CONVERTKIT_API_KEY=
# curl https://api.convertkit.com/v3/forms?api_key=<your_public_api_key> to get your form ID
CONVERTKIT_FORM_ID=

KLAVIYO_API_KEY=
KLAVIYO_LIST_ID=

REVUE_API_KEY=

EMAILOCTOPUS_API_KEY=
EMAILOCTOPUS_LIST_ID=

# Umami analytics.
# UMAMI_ID (website ID) is required for pageview/event tracking.
# UMAMI_API_TOKEN is only needed for the /api/views view counter:
#   - Umami Cloud: an API key (Settings > API keys), used with UMAMI_API_URL=https://api.umami.is/v1
#   - Self-hosted: a bearer token, with UMAMI_API_URL=https://<your-host>/api
UMAMI_ID=
UMAMI_API_TOKEN=
UMAMI_API_URL=https://api.umami.is/v1

# Weekly stats email (GET /api/cron/stats-email), sent via Resend.
# Triggered by .github/workflows/weekly-stats-email.yml, which also needs
# the SITE_URL and CRON_SECRET repo secrets set to match these.
RESEND_API_KEY=
STATS_EMAIL_FROM=
STATS_EMAIL_TO=
CRON_SECRET=
